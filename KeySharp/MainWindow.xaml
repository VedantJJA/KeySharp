<ui:FluentWindow x:Class="KeySharp.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
            Title="KeySharp Pro" 
            Height="550" Width="780" 
            MinHeight="500" MinWidth="700"
            WindowStartupLocation="CenterScreen"
            WindowBackdropType="Mica"
            Icon="Images/app.png"
            ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Native Theme Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="KeySharp Pro" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR TABS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="ModeListBox" Grid.Row="0" SelectionChanged="ModeListBox_SelectionChanged" SelectedIndex="0" Margin="8,0,0,8" Background="Transparent" BorderThickness="0">
                    <ListBoxItem Padding="12,10" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PaintBrush24" Margin="0,0,12,0"/>
                            <TextBlock Text="Static (Solid)" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherSunny24" Margin="0,0,12,0"/>
                            <TextBlock Text="Rainbow Wave" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" Margin="0,0,12,0"/>
                            <TextBlock Text="Ripple" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Headphones24" Margin="0,0,12,0"/>
                            <TextBlock Text="Music Beat Sync" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,12,0"/>
                            <TextBlock Text="Screen Mirror" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- SETTINGS TAB (BOTTOM) -->
                <ListBox x:Name="SettingsListBox" Grid.Row="1" SelectionChanged="SettingsListBox_SelectionChanged" Margin="8,0,0,8" Background="Transparent" BorderThickness="0">
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- SETTINGS PANELS (MAIN RGB VIEW) -->
            <ScrollViewer x:Name="MainContentPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,12,8">
                <StackPanel Margin="8">

                    <TextBlock x:Name="ModeTitle" Text="STATIC (SOLID)" FontSize="16" FontWeight="Bold" Opacity="0.8" Margin="0,0,0,12"/>

                    <!-- GLOBAL BRIGHTNESS CARD -->
                    <ui:Card Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="GLOBAL BRIGHTNESS" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BrightnessVal" Text="100%" FontSize="11" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="SliderBrightness" Minimum="0" Maximum="100" Value="100" ValueChanged="SliderBrightness_ValueChanged" Focusable="False" IsTabStop="False" Margin="0,0,0,2"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- MUSIC SYNC PANEL -->
                    <StackPanel x:Name="MusicPanel" Visibility="Collapsed">
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="BEAT SENSITIVITY" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ThresholdVal" Text="50%" FontSize="11" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderThreshold" Minimum="1" Maximum="100" Value="50" ValueChanged="SliderThreshold_ValueChanged" Focusable="False" IsTabStop="False" Margin="0,0,0,2"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- RAINBOW WAVE SETTINGS -->
                    <StackPanel x:Name="RainbowPanel" Visibility="Collapsed">
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="RAINBOW SPREAD" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RainbowSpreadVal" Text="5" FontSize="11" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderRainbowSpread" Minimum="1" Maximum="30" Value="5" ValueChanged="SliderRainbowSpread_ValueChanged" Focusable="False" IsTabStop="False" Margin="0,0,0,10"/>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="WAVE SPEED" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RainbowSpeedVal" Text="20ms" FontSize="11" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderRainbowSpeed" Minimum="1" Maximum="200" Value="20" ValueChanged="SliderRainbowSpeed_ValueChanged" IsDirectionReversed="True" Focusable="False" IsTabStop="False" Margin="0,0,0,2"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- RIPPLE SETTINGS -->
                    <StackPanel x:Name="RipplePanel" Visibility="Collapsed">
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="RIPPLE SETTINGS" FontSize="11" FontWeight="Bold" Opacity="0.7" Margin="0,0,0,8"/>

                                <!-- Ripple Type Selector -->
                                <DockPanel x:Name="RippleTypeRow" Margin="0,0,0,10">
                                    <TextBlock Text="TYPE" FontSize="11" FontWeight="SemiBold" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="RippleTypeCombo" SelectedIndex="0" SelectionChanged="RippleTypeCombo_SelectionChanged" Focusable="False" IsTabStop="False">
                                        <ComboBoxItem Content="Fixed Color"/>
                                        <ComboBoxItem Content="Per-Zone Rainbow"/>
                                        <ComboBoxItem Content="Per-Key Random"/>
                                    </ComboBox>
                                </DockPanel>

                                <ui:ToggleSwitch Content="Enable Wall Bounce" x:Name="BounceToggle" Checked="Bounce_Changed" Unchecked="Bounce_Changed" Margin="0,0,0,10" FontSize="12" Focusable="False" IsTabStop="False"/>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="DISTANCE" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                                    <TextBlock x:Name="DistanceVal" Text="5" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderSteps" Minimum="1" Maximum="80" Value="5" ValueChanged="SliderSteps_ValueChanged" Focusable="False" IsTabStop="False" Margin="0,0,0,10"/>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="WIDTH" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                                    <TextBlock x:Name="WidthVal" Text="1" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderWidth" Minimum="1" Maximum="10" Value="1" ValueChanged="SliderWidth_ValueChanged" Focusable="False" IsTabStop="False" Margin="0,0,0,10"/>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="SPEED" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                                    <TextBlock x:Name="SpeedVal" Text="20ms" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderSpeed" Minimum="1" Maximum="100" Value="20" ValueChanged="SliderSpeed_ValueChanged" IsDirectionReversed="True" Focusable="False" IsTabStop="False" Margin="0,0,0,4"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- COLOR MIXER -->
                    <StackPanel x:Name="ColorPanel">
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="COLOR PRESETS" FontSize="11" FontWeight="Bold" Opacity="0.7" Margin="0,0,0,10"/>

                                <UniformGrid Columns="6" Margin="0,0,0,4" Height="24" HorizontalAlignment="Left">
                                    <Border Background="#FF3B30" Tag="255,0,0" MouseLeftButtonDown="Preset_Click" Width="24" Height="24" Margin="0,0,8,0" CornerRadius="4" Cursor="Hand" ToolTip="Red"/>
                                    <Border Background="#34C759" Tag="52,199,89" MouseLeftButtonDown="Preset_Click" Width="24" Height="24" Margin="0,0,8,0" CornerRadius="4" Cursor="Hand" ToolTip="Green"/>
                                    <Border Background="#007AFF" Tag="0,30,255" MouseLeftButtonDown="Preset_Click" Width="24" Height="24" Margin="0,0,8,0" CornerRadius="4" Cursor="Hand" ToolTip="Blue"/>
                                    <Border Background="#AF52DE" Tag="201,0,255" MouseLeftButtonDown="Preset_Click" Width="24" Height="24" Margin="0,0,8,0" CornerRadius="4" Cursor="Hand" ToolTip="Purple"/>
                                    <Border Background="#FFCC00" Tag="255,204,0" MouseLeftButtonDown="Preset_Click" Width="24" Height="24" Margin="0,0,8,0" CornerRadius="4" Cursor="Hand" ToolTip="Yellow"/>

                                    <ToggleButton x:Name="CustomColorBtn" Content="+" Width="24" Height="24" Padding="0" ToolTip="Custom Color" Checked="CustomColor_Toggle" Unchecked="CustomColor_Toggle" Margin="0" BorderThickness="1" BorderBrush="#555555" Background="Transparent" Foreground="White"/>
                                </UniformGrid>

                                <!-- CUSTOM 2D COLOR PICKER -->
                                <StackPanel x:Name="CustomColorPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock Text="CUSTOM COLOR" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 2D Canvas -->
                                        <Border BorderBrush="#333" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Width="130" Height="130" Margin="0,0,12,0">
                                            <Canvas x:Name="ColorCanvas" MouseLeftButtonDown="ColorCanvas_MouseDown" MouseMove="ColorCanvas_MouseMove" MouseLeftButtonUp="ColorCanvas_MouseUp" Background="Transparent" Cursor="Cross">
                                                <Rectangle x:Name="ColorCanvasBackground" Width="130" Height="130" Fill="#FF0000"/>
                                                <Rectangle Width="130" Height="130">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Rectangle Width="130" Height="130">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                            <GradientStop Color="#FF000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>

                                                <Ellipse x:Name="ColorThumb" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent" Margin="-6,-6,0,0" IsHitTestVisible="False">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.5"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Canvas>
                                        </Border>

                                        <!-- Hue Vertical Slider -->
                                        <Border Grid.Column="1" Height="130" CornerRadius="4" ClipToBounds="True" BorderBrush="#333" BorderThickness="1" Margin="0,0,12,0">
                                            <Grid>
                                                <Rectangle>
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                            <GradientStop Color="#FF0000" Offset="0.0"/>
                                                            <GradientStop Color="#FFFF00" Offset="0.167"/>
                                                            <GradientStop Color="#00FF00" Offset="0.333"/>
                                                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                            <GradientStop Color="#0000FF" Offset="0.667"/>
                                                            <GradientStop Color="#FF00FF" Offset="0.833"/>
                                                            <GradientStop Color="#FF0000" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Slider x:Name="HueSlider" Orientation="Vertical" Minimum="0" Maximum="360" Value="0" ValueChanged="HueSlider_ValueChanged" Opacity="0.01" />

                                                <Canvas IsHitTestVisible="False">
                                                    <Path x:Name="HueThumbVisual" Data="M 0,0 L 5,5 L 0,10 Z" Fill="White" Canvas.Right="-1"/>
                                                </Canvas>
                                            </Grid>
                                        </Border>

                                        <!-- HEX & RGB Texts -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <TextBox x:Name="HexInput" Text="#FF0000" Margin="0,0,0,12" Padding="6,4" FontFamily="Consolas" TextChanged="HexInput_TextChanged"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="R" VerticalAlignment="Center" Margin="0,0,8,0" Width="12" Foreground="#FF4444" FontWeight="Bold"/>
                                                <TextBox x:Name="InputR" Grid.Column="1" Text="255" Padding="4,2" TextChanged="RgbInput_TextChanged"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="G" VerticalAlignment="Center" Margin="0,0,8,0" Width="12" Foreground="#44FF44" FontWeight="Bold"/>
                                                <TextBox x:Name="InputG" Grid.Column="1" Text="0" Padding="4,2" TextChanged="RgbInput_TextChanged"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="B" VerticalAlignment="Center" Margin="0,0,8,0" Width="12" Foreground="#4444FF" FontWeight="Bold"/>
                                                <TextBox x:Name="InputB" Grid.Column="1" Text="0" Padding="4,2" TextChanged="RgbInput_TextChanged"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- SCREEN MIRROR PANEL -->
                    <StackPanel x:Name="ScreenMirrorPanel" Visibility="Collapsed">
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="SCREEN MIRROR SETTINGS" FontSize="11" FontWeight="Bold" Opacity="0.7" Margin="0,0,0,10"/>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TARGET SCREEN" FontSize="11" FontWeight="SemiBold" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="ScreenMirrorCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="ScreenMirrorCombo_SelectionChanged" Focusable="False" IsTabStop="False">
                                        <ComboBoxItem Content="Primary Monitor"/>
                                    </ComboBox>
                                </Grid>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="REFRESH RATE (FPS)" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                                    <TextBlock x:Name="ScreenMirrorSpeedVal" Text="30 FPS" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderScreenMirrorSpeed" Minimum="10" Maximum="60" Value="30" ValueChanged="SliderScreenMirrorSpeed_ValueChanged" Focusable="False" IsTabStop="False" Margin="0,0,0,4"/>

                                <ui:ToggleSwitch x:Name="ScreenMirrorContrastToggle" Content="High Contrast Mode" Checked="ScreenMirrorContrastToggle_Changed" Unchecked="ScreenMirrorContrastToggle_Changed" Margin="0,4,0,4" FontSize="12" Focusable="False" IsTabStop="False"/>

                                <TextBlock Text="Note: Capture area coordinates map directly to key positions on your keyboard for accurate ambient lighting. Highly resource optimized." FontSize="10" Opacity="0.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- APP SETTINGS PANEL -->
            <ScrollViewer x:Name="SettingsContentPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,12,8" Visibility="Collapsed">
                <StackPanel Margin="8">
                    <TextBlock x:Name="SettingsTitle" Text="SETTINGS" FontSize="16" FontWeight="Bold" Opacity="0.8" Margin="0,0,0,12"/>

                    <!-- MAIN SETTINGS VIEW -->
                    <StackPanel x:Name="SettingsMainView">

                        <!-- GENERAL SETTINGS -->
                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="General" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <!-- Connected Device Status -->
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock Text="Connected Device:" VerticalAlignment="Center" Opacity="0.8" FontSize="12"/>
                                    <TextBlock x:Name="DeviceStatusText" Text="Searching..." FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#FFCC00"/>
                                </DockPanel>

                                <!-- Auto-Start Toggle -->
                                <ui:ToggleSwitch x:Name="AutoStartToggle" Content="Launch KeySharp on Windows Startup" Margin="0,0,0,8" Checked="AutoStartToggle_Changed" Unchecked="AutoStartToggle_Changed"/>

                                <!-- Dynamic Lighting Priority Button -->
                                <ui:Button x:Name="ManagePriorityBtn" Content="Windows Dynamic Lighting Settings" Click="ManagePriority_Click" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="8,6" FontSize="12" Margin="0,0,0,8">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Settings24"/>
                                    </ui:Button.Icon>
                                </ui:Button>

                                <!-- Manual Setup Tour Button -->
                                <ui:Button Content="Restart Quick Start Tour" Click="RestartTour_Click" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="8,6" FontSize="12" Margin="0,0,0,4">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="BookQuestionMark24"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </ui:Card>

                        <!-- POWER MANAGEMENT SETTINGS -->
                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Power Management" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <!-- Battery Toggle -->
                                <ui:ToggleSwitch x:Name="OffOnBatteryToggle" Content="Turn off RGB on Battery Power" Margin="0,0,0,12" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"/>

                                <!-- Charger Toggle -->
                                <ui:ToggleSwitch x:Name="ChargerRippleToggle" Content="Trigger Ripple on Charger Connect/Disconnect" Margin="0,0,0,16" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"/>

                                <!-- Zone Selector -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Charger Ripple Start Zone:" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8"/>

                                    <!-- Dynamically Populated from Hardware Array -->
                                    <ComboBox x:Name="ChargerZoneCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="SettingsCombo_Changed">
                                        <ComboBoxItem Content="Middle"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- TOOLS -->
                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Tools" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <ui:Button Content="Open Map Test Mode" Click="OpenMapTest_Click" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="10" FontSize="12" Margin="0,0,0,8" Cursor="Hand">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Beaker24"/>
                                    </ui:Button.Icon>
                                </ui:Button>

                                <ui:Button Content="Preview Zone Map" Click="OpenZonePreview_Click" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="10" FontSize="12" Margin="0,0,0,8" Cursor="Hand">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Grid24"/>
                                    </ui:Button.Icon>
                                </ui:Button>

                                <ui:Button x:Name="OpenCalibrationBtn" Content="Open Hardware Calibration" Click="OpenCalibration_Click" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="10" FontSize="12" Cursor="Hand">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Wrench24"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </ui:Card>

                    </StackPanel>

                    <!-- INLINE MAP TEST VIEW (shown when Map Test is activated from Settings) -->
                    <StackPanel x:Name="SettingsMapTestView" Visibility="Collapsed">
                        <ui:Button Content="← Back to Settings" Click="BackToSettings_Click" Appearance="Secondary" Margin="0,0,0,12" Padding="8,6" FontSize="12" Cursor="Hand"/>
                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="MAP TEST MODE" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Press any key on your keyboard. The corresponding hardware zone will light up to confirm your keymap is correct." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12" LineHeight="20"/>
                                <Border Background="#1A1A1A" CornerRadius="4" Padding="10">
                                    <TextBlock x:Name="MapTestStatusText" Text="Waiting for key press..." Foreground="#00FFCC" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- INLINE CALIBRATION VIEW (shown when Calibration is activated from Settings) -->
                    <StackPanel x:Name="SettingsCalibrationView" Visibility="Collapsed">
                        <ui:Button Content="← Back to Settings" Click="BackToSettings_Click" Appearance="Secondary" Margin="0,0,0,12" Padding="8,6" FontSize="12" Cursor="Hand"/>
                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="HARDWARE CALIBRATION" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Border Background="#1A1A1A" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                    <TextBlock x:Name="ZoneInfoText" Text="Zone: 0" Foreground="#00FFCC" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>

                                <UniformGrid Columns="2" Margin="0,0,0,12" Rows="1">
                                    <ui:Button Content="PREV" Click="PrevZone_Click" Margin="0,0,6,0" HorizontalAlignment="Stretch" Padding="6" FontSize="12" Focusable="False" IsTabStop="False"/>
                                    <ui:Button Content="NEXT" Click="NextZone_Click" Margin="6,0,0,0" HorizontalAlignment="Stretch" Padding="6" FontSize="12" Focusable="False" IsTabStop="False"/>
                                </UniformGrid>

                                <ui:Button Content="SAVE MAP" Click="SaveBtn_Click" Appearance="Primary" Margin="0,0,0,8" HorizontalAlignment="Stretch" Padding="6" FontSize="12" Focusable="False" IsTabStop="False"/>
                                <ui:Button Content="LOAD MAP" Click="LoadBtn_Click" HorizontalAlignment="Stretch" Padding="6" FontSize="12" Focusable="False" IsTabStop="False"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- INLINE ZONE PREVIEW VIEW (shown when Zone Preview is activated from Settings) -->
                    <StackPanel x:Name="SettingsZonePreviewView" Visibility="Collapsed">
                        <ui:Button Content="← Back to Settings" Click="BackToSettings_Click" Appearance="Secondary" Margin="0,0,0,12" Padding="8,6" FontSize="12" Cursor="Hand"/>
                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ZONE MAP PREVIEW" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Each color represents a different hardware zone. Keys in the same zone share the same color." TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,0,0,14"/>


                                <Border Background="#0E0E0E" CornerRadius="6" Padding="12" Margin="0,0,0,4">
                                    <Canvas x:Name="ZonePreviewCanvas" Height="210" ClipToBounds="True"/>
                                </Border>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- WELCOME OVERLAY / GUIDED TOUR OVERLAY -->
            <Grid x:Name="WelcomeOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#95000000" Visibility="Collapsed" Panel.ZIndex="200" SizeChanged="WelcomeOverlay_SizeChanged">
                <!-- Glowing Tour Highlight Box -->
                <Border x:Name="TourHighlight" BorderBrush="#00FFCC" BorderThickness="2.5" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#00FFCC" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                    </Border.Effect>
                </Border>

                <!-- Callout Bubble Card -->
                <ui:Card x:Name="TourBubble" Width="330" Padding="16" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#1C1C1E" BorderBrush="#333">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon x:Name="TourIcon" Symbol="PaintBrush24" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#00FFCC" Filled="True"/>
                            <TextBlock x:Name="TourTitle" Text="Tour Title" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>

                        <TextBlock x:Name="TourDescription" Text="Tour description..." FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,16" Opacity="0.9" Foreground="#DDD"/>
                        
                        <!-- Dynamic Tour Action Button -->
                        <ui:Button x:Name="TourActionButton" Content="Action" Click="TourActionButton_Click" Appearance="Primary" HorizontalAlignment="Stretch" Padding="8" FontSize="12" Visibility="Collapsed" Margin="0,0,0,16"/>

                        <DockPanel>
                            <!-- Step counter -->
                            <TextBlock x:Name="TourStepCounter" Text="1/5" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Foreground="White"/>
                            
                            <!-- Navigation -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="TourSkipBtn" Content="Skip" Click="SetupSkip_Click" Margin="0,0,12,0" Padding="8,3" FontSize="11" Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand"/>
                                <ui:Button x:Name="SetupPrevBtn" Content="&lt; Back" Click="SetupPrev_Click" Margin="0,0,8,0" Padding="12,4" FontSize="11" Background="Transparent" Foreground="White" BorderBrush="#444" IsEnabled="False"/>
                                <ui:Button x:Name="SetupNextBtn" Content="Next &gt;" Click="SetupNext_Click" Appearance="Primary" Padding="14,4" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>